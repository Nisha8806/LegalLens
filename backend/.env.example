# PostgreSQL
DATABASE_URL=postgresql://legallens:legallens@localhost:5432/legallens

# Embeddings: choose ONE provider and set EMBEDDING_PROVIDER accordingly.
# 'openai'            -> requires OPENAI_API_KEY, dim 1536 (text-embedding-3-small)
# 'sentence-transformers' -> local model, no key needed, dim 384/768 (adjust schema VECTOR() dim to match)
EMBEDDING_PROVIDER=sentence-transformers
OPENAI_API_KEY=

# LLM used for AI annotations / RAG answer synthesis (kept separate from
# retrieval so it's obvious in code + in the DB which content is model output)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
